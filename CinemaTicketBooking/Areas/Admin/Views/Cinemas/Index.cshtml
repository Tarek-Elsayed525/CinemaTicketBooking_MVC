@model IEnumerable<CinemaTicketBooking.Models.Cinema>

@{
    ViewData["Title"] = "All Cinemas";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container-fluid px-5 py-4">
    <!-- Header with Title & Create New Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">All Cinemas</h2>
            <p class="text-muted fs-6 mb-0">إدارة وتصفح جميع دور السينما في النظام باحترافية</p>
        </div>
        <a asp-action="Create" class="btn btn-success px-4 py-2 rounded-pill shadow-sm fw-semibold">
            <i class="fas fa-plus me-2"></i> Create New
        </a>
    </div>

    <!-- Cinemas Data Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary border-bottom">
                        <tr>
                            <th class="py-3 ps-4" style="width: 70px;">#</th>
                            <th class="py-3 text-start ps-3" style="width: 30%;">Cinema Name</th>
                            <th class="py-3 text-start ps-3" style="width: 40%;">Description</th>
                            <th class="py-3 text-end pe-4" style="width: 30%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int index = (currentPage - 1) * 5 + 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <!-- Index Number -->
                                    <td class="py-3 ps-4 fw-bold text-muted">@index</td>
                                    
                                    <!-- Cinema Name -->
                                    <td class="py-3 text-start ps-3">
                                        <span class="fw-semibold text-dark" style="font-size: 0.95rem;">@item.Name</span>
                                    </td>

                                    <!-- Description -->
                                    <td class="py-3 text-start ps-3">
                                        <span class="text-muted text-truncate d-inline-block" style="max-width: 350px; font-size: 0.9rem;">@(item.Description ?? "No Description")</span>
                                    </td>
                                    
                                    <!-- Actions Buttons -->
                                    <td class="py-3 text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning text-white px-3 py-1 rounded-pill fw-semibold shadow-none">
                                                <i class="fas fa-edit me-1"></i> Edit
                                            </a>
                                            <!-- Delete Button with SweetAlert -->
                                            <button type="button" onclick="confirmDelete(@item.Id)" class="btn btn-danger px-3 py-1 rounded-pill fw-semibold shadow-none">
                                                <i class="fas fa-trash-alt me-1"></i> Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="text-muted fs-6">لا توجد دور سينما مضافة حتى الآن. اضغط على Create New لإضافة أول سينما!</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Centered & Enhanced Pagination Footer -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-4 text-center">
                <nav aria-label="Page navigation" class="d-flex justify-content-center align-items-center flex-column gap-2">
                    <ul class="pagination pagination-md mb-0 shadow-sm rounded-pill p-1 bg-light border">
                        <!-- Previous Button -->
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link rounded-pill px-3 fw-bold border-0" asp-action="Index" asp-route-page="@(currentPage - 1)">
                                <i class="fas fa-chevron-left me-1"></i> Previous
                            </a>
                        </li>

                        <!-- Page Numbers -->
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")">
                                <a class="page-link rounded-circle mx-1 fw-bold border-0 @(currentPage == i ? "bg-primary text-white shadow-sm" : "text-dark")" 
                                   style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;"
                                   asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }

                        <!-- Next Button -->
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link rounded-pill px-3 fw-bold border-0" asp-action="Index" asp-route-page="@(currentPage + 1)">
                                Next <i class="fas fa-chevron-right ms-1"></i>
                            </a>
                        </li>
                    </ul>

                    <!-- Page Counter Text -->
                    <span class="text-muted fs-7 fw-semibold mt-1">
                        Page <span class="badge bg-secondary">@currentPage</span> of <span class="badge bg-secondary">@totalPages</span>
                    </span>
                </nav>
            </div>
        }
    </div>
</div>

@section Scripts {
    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function confirmDelete(id) {
            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/Admin/Cinemas/Delete/${id}`;
                }
            });
        }
    </script>
}