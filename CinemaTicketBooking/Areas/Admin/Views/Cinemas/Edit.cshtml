@model CinemaTicketBooking.Models.Cinema

@{
    ViewData["Title"] = "Edit Cinema";
}

<div class="container-fluid px-5 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="font-size: 1.75rem;">Edit Cinema</h2>
            <p class="text-muted fs-6 mb-0">تعديل بيانات دور السينما الحالية باحترافية</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold shadow-sm">
            <i class="fas fa-arrow-right me-2"></i> Back to List
        </a>
    </div>

    <!-- TempData Error Alert -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Form Card -->
    <div class="row">
        <div class="col-lg-10 col-xl-9">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Hidden Fields for Id and Existing Image -->
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Image" />

                    <!-- Cinema Name Field -->
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-bold text-dark" style="font-size: 0.95rem;">Cinema Name</label>
                        <input asp-for="Name" class="form-control form-control-lg rounded-3 shadow-none" style="font-size: 0.9rem;" placeholder="Enter cinema name..." />
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Description Field -->
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold text-dark" style="font-size: 0.95rem;">Description</label>
                        <textarea asp-for="Description" class="form-control rounded-3 shadow-none" style="font-size: 0.9rem;" rows="4" placeholder="Enter cinema description..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Image Upload Field & Preview Box -->
                    <div class="mb-4">
                        <label for="image" class="form-label fw-bold text-dark" style="font-size: 0.95rem;">Cinema Image</label>
                        <input type="file" name="image" id="imageInput" class="form-control form-control-lg rounded-3 shadow-none mb-3" style="font-size: 0.9rem;" accept="image/*" onchange="previewImage(event)" />

                        <!-- Image Preview Box (معاينة الصورة الحالية أو الجديدة) -->
                        <div class="mt-2">
                            <span class="d-block text-muted small mb-2 fw-semibold">Current / Selected Image Preview:</span>
                            <div id="imagePreviewContainer" class="border rounded-3 p-2 bg-light text-center" style="width: 160px; height: 160px; overflow: hidden; position: relative;">
                                @if (!string.IsNullOrEmpty(Model?.Image))
                                {
                                    <img id="outputImage" src="~/CinemaImages/@Model.Image" alt="@Model.Name" class="w-100 h-100 rounded-2" style="object-fit: cover;" />
                                }
                                else
                                {
                                    <img id="outputImage" src="#" alt="No Image" class="w-100 h-100 rounded-2 d-none" style="object-fit: cover;" />
                                    <span id="noImageText" class="text-muted small d-flex align-items-center justify-content-center h-100">No Image Uploaded</span>
                                }
                            </div>
                        </div>

                        <span class="text-muted small mt-2 d-block">اترك هذا الحقل فارغاً إذا كنت لا ترغب في تغيير الصورة الحالية.</span>
                    </div>

                    <!-- Submit & Cancel Buttons -->
                    <div class="d-flex gap-2 pt-2">
                        <button type="submit" class="btn btn-warning text-white px-4 py-2 rounded-pill fw-semibold shadow-sm" style="font-size: 0.95rem;">
                            <i class="fas fa-save me-2"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-light px-4 py-2 rounded-pill fw-semibold text-secondary" style="font-size: 0.95rem;">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- JavaScript لتحديث معاينة الصورة فور تغييرها -->
    <script>
        function previewImage(event) {
            var reader = new FileReader();
            var outputImage = document.getElementById('outputImage');
            var noImageText = document.getElementById('noImageText');

            reader.onload = function () {
                outputImage.src = reader.result;
                outputImage.classList.remove('d-none');
                if (noImageText) {
                    noImageText.classList.add('d-none');
                }
            }

            if (event.target.files[0]) {
                reader.readAsDataURL(event.target.files[0]);
            }
        }
    </script>
}