@model CinemaTicketBooking.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Create New Category</h2>
            <p class="text-muted fs-6 mb-0">إضافة تصنيف جديد مع كافة التفاصيل</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
            <i class="fas fa-arrow-right me-2"></i> Back to List
        </a>
    </div>

    <!-- Form Card -->
    <div class="row">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Category Name Field -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold text-dark">Category Name</label>
                        <input asp-for="Name" class="form-control form-control-lg rounded-3 fs-6" placeholder="Enter category name (e.g. Action, Comedy)" />
                        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Description Field -->
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold text-dark">Description</label>
                        <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Enter category description..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Status Field (اختيارين للحالة True أو False) -->
                    <div class="mb-4">
                        <label asp-for="Status" class="form-label fw-bold text-dark">Status</label>
                        <select asp-for="Status" class="form-select form-select-lg rounded-3 fs-6">
                            <option value="true">Active (نشط)</option>
                            <option value="false">Inactive (غير نشط)</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Submit & Cancel Buttons -->
                    <div class="d-flex gap-2 pt-2">
                        <button type="submit" class="btn btn-success px-4 py-2 rounded-pill fw-semibold shadow-sm">
                            <i class="fas fa-save me-2"></i> Save Category
                        </button>
                        <a asp-action="Index" class="btn btn-light px-4 py-2 rounded-pill fw-semibold text-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}