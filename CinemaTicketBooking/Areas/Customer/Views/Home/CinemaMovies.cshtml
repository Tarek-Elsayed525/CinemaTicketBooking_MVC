@model IEnumerable<CinemaTicketBooking.Models.Movie>

@{
    ViewData["Title"] = "أفلام " + ViewBag.CinemaName;
}

<style>
    .movie-card {
        transition: transform 0.25s ease-in-out, box-shadow 0.25s ease-in-out;
        cursor: pointer;
        border: none;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
    }

    .movie-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.12) !important;
    }

    .movie-img-container {
        height: 300px;
        overflow: hidden;
        position: relative;
        background: #0f172a;
    }

    .movie-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .category-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        background: rgba(13, 110, 253, 0.85);
        backdrop-filter: blur(4px);
        color: #fff;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .price-badge {
        position: absolute;
        bottom: 15px;
        left: 15px;
        background: rgba(25, 135, 84, 0.9);
        backdrop-filter: blur(4px);
        color: #fff;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 700;
    }
</style>

<!-- Header Section -->
<div class="d-flex justify-content-between align-items-center my-4 py-2 border-bottom">
    <div>
        <h2 class="fw-bold text-primary mb-1">أفلام @ViewBag.CinemaName 🎥</h2>
        <p class="text-muted fs-6 mb-0">اختر الفيلم للاطلاع على تفاصيله، أبطاله، وحجز التذاكر</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="fas fa-arrow-right me-1"></i> العودة للسينمات
    </a>
</div>

<div class="row g-4 mb-5">
    @if (Model != null && Model.Any())
    {
        @foreach (var movie in Model)
        {
            <div class="col-md-6 col-lg-4">
                <!-- الضغط على المربع بالكامل ينقل لصفحة تفاصيل الفيلم -->
                <a asp-area="Customer" asp-controller="Home" asp-action="MovieDetails" asp-route-id="@movie.Id" class="text-decoration-none">
                    <div class="card movie-card shadow-sm h-100">
                        <div class="movie-img-container">
                            <img src="@Url.Content("~/moviesImages/" + System.IO.Path.GetFileName(movie.MainImage))" 
                                 alt="@movie.Name" 
                                 onerror="this.onerror=null; this.src='https://via.placeholder.com/300x400?text=Movie+Image';" />
                            
                            @if (movie.Category != null)
                            {
                                <span class="category-badge">🏷️ @movie.Category.Name</span>
                            }
                            <span class="price-badge">💰 @movie.Price.ToString("C")</span>
                        </div>
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <h4 class="fw-bold text-dark mb-2">@movie.Name</h4>
                                <p class="text-muted small mb-0" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.6;">
                                    @movie.Description
                                </p>
                            </div>
                            <div class="pt-3 mt-3 border-top d-flex justify-content-between align-items-center">
                                <span class="text-primary fw-semibold small">التفاصيل والأبطال 🎟️</span>
                                <i class="fas fa-chevron-left text-primary"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="alert alert-info d-inline-block px-5 py-3 rounded-3 shadow-sm">
                لا توجد أفلام معروضة حالياً في هذه السينما.
            </div>
        </div>
    }
</div>

<!-- التصفح (Pagination) -->
@if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
{
    <nav aria-label="Movie navigation" class="mb-5 d-flex justify-content-center">
        <ul class="pagination shadow-sm rounded-pill bg-white p-2">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link border-0 rounded-pill px-3" asp-action="CinemaMovies" asp-route-id="@ViewBag.CinemaId" asp-route-page="@(ViewBag.CurrentPage - 1)">السابق</a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                    <a class="page-link border-0 rounded-circle mx-1 text-center" style="width: 38px; height: 38px; line-height: 24px;" asp-action="CinemaMovies" asp-route-id="@ViewBag.CinemaId" asp-route-page="@i">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link border-0 rounded-pill px-3" asp-action="CinemaMovies" asp-route-id="@ViewBag.CinemaId" asp-route-page="@(ViewBag.CurrentPage + 1)">التالي</a>
            </li>
        </ul>
    </nav>
}
