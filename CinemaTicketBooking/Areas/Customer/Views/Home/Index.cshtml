@model IEnumerable<CinemaTicketBooking.Models.Cinema>

@{
    ViewData["Title"] = "السينمات المتاحة";
}

<style>
    .cinema-card {
        transition: transform 0.25s ease-in-out, box-shadow 0.25s ease-in-out;
        cursor: pointer;
        border: none;
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
    }

        .cinema-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1) !important;
        }

    .cinema-img-container {
        height: 220px;
        overflow: hidden;
        position: relative;
        background: #f1f5f9;
    }

    .cinema-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .cinema-badge {
        position: absolute;
        top: 15px;
        right: 15px;
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(4px);
        color: #fff;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }
</style>

<div class="text-center my-4 py-2">
    <h2 class="fw-bold text-primary mb-2">اختر السينما المفضلة لديك 🎬</h2>
    <p class="text-muted fs-6">اضغط على أي سينما لتصفح الأفلام المعروضة بها وحجز تذكرتك فوراً</p>
</div>

<div class="row g-4 mb-5">
    @if (Model != null && Model.Any())
    {
        @foreach (var cinema in Model)
        {
            <div class="col-md-6 col-lg-4">
                <a asp-area="Customer" asp-controller="Home" asp-action="CinemaMovies" asp-route-id="@cinema.Id" class="text-decoration-none">
                    <div class="card cinema-card shadow-sm h-100">
                        <div class="cinema-img-container">
                            <!-- طريقة عرض مباشرة وآمنة للصورة بالاعتماد على جذر الموقع -->
                            <img src="@Url.Content("~/Cinemaimages/" + System.IO.Path.GetFileName(cinema.Image))" alt="@cinema.Name" onerror="this.onerror=null; this.src='@Url.Content("~/Cinemaimages/1.png")';" />
                        </div>
                        <div class="card-body p-4 d-flex flex-column justify-content-between">
                            <div>
                                <h4 class="fw-bold text-dark mb-2">@cinema.Name</h4>
                                <p class="text-muted small mb-0" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.6;">
                                    @cinema.Description
                                </p>
                            </div>
                            <div class="pt-3 mt-3 border-top d-flex justify-content-between align-items-center">
                                <span class="text-primary fw-semibold small">استكشف العروض 🍿</span>
                                <i class="fas fa-arrow-left text-primary"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="alert alert-warning d-inline-block px-5 py-3 rounded-3 shadow-sm">
                لا توجد سينمات متاحة حالياً.
            </div>
        </div>
    }
</div>

<!-- التصفح (Pagination) - يظهر تلقائياً إذا كان عدد الصفحات أكبر من 1 -->
@if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
{
    <nav aria-label="Cinema navigation" class="mb-5 d-flex justify-content-center">
        <ul class="pagination shadow-sm rounded-pill bg-white p-2">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link border-0 rounded-pill px-3" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)">السابق</a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                    <a class="page-link border-0 rounded-circle mx-1 text-center" style="width: 38px; height: 38px; line-height: 24px;" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link border-0 rounded-pill px-3" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">التالي</a>
            </li>
        </ul>
    </nav>
}