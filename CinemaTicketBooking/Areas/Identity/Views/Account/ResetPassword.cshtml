@model CinemaTicketBooking.View_Model.ResetPasswordVM

@{
    ViewData["Title"] = "Reset Password";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="width: 100%; max-width: 450px; background: #ffffff;">

        <!-- Header Section -->
        <div class="text-center mb-4">
            <div class="mb-3">
                <span class="p-3 bg-light text-primary rounded-circle" style="font-size: 24px;">🔒</span>
            </div>
            <h3 class="fw-bold text-dark">Reset Password</h3>
            <p class="text-muted" style="font-size: 14px;">Enter your new password below to secure your account.</p>
        </div>

        <!-- Form Section -->
        <form asp-action="ResetPassword" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 13px;"></div>
             
            <!-- Hidden Field for User Id -->
       
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />

            <!-- New Password Input -->
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label fw-semibold text-secondary" style="font-size: 14px;"></label>
                <input asp-for="NewPassword" class="form-control rounded-3 py-2 px-3" placeholder="Enter new password" style="border: 1px solid #ced4da;" />
                <span asp-validation-for="NewPassword" class="text-danger" style="font-size: 12px; display: block; margin-top: 5px;"></span>
            </div>

            <!-- Confirm Password Input -->
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary" style="font-size: 14px;"></label>
                <input asp-for="ConfirmPassword" class="form-control rounded-3 py-2 px-3" placeholder="Confirm new password" style="border: 1px solid #ced4da;" />
                <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 12px; display: block; margin-top: 5px;"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn w-100 py-3 text-white fw-bold rounded-3 shadow-sm" style="background: linear-gradient(135deg, #0d6efd, #0b5ed7); transition: background 0.2s;">
                Update Password
            </button>

            <!-- Back to Login Link -->
            <div class="text-center mt-3">
                <p style="margin: 0; color: #64748b; font-size: 14px;">Remember your password? <a asp-action="Login" style="color: #0d6efd; text-decoration: none; font-weight: bold;">Login</a></p>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}