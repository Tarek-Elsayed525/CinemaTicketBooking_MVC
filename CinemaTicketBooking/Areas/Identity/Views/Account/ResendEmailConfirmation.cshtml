@model CinemaTicketBooking.View_Model.ResendEmailConfirmationVM

@{
    ViewData["Title"] = "Resend Email Confirmation";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-lg border-0 rounded-4 p-4" style="width: 100%; max-width: 450px; background: #ffffff;">

        <!-- Header Section -->
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark">📧 Resend Confirmation</h3>
            <p class="text-muted" style="font-size: 14px;">Enter your email or username to resend the confirmation link.</p>
        </div>

        <!-- Form Section -->
        <form asp-action="ResendEmailConfirmation" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size: 13px;"></div>

            <!-- Username or Email Input -->
            <div class="mb-3">
                <label asp-for="UserNameOrEmail" class="form-label fw-semibold text-secondary" style="font-size: 14px;"></label>
                <input asp-for="UserNameOrEmail" class="form-control rounded-3 py-2 px-3" placeholder="Enter your username or email" style="border: 1px solid #ced4da;" />
                <span asp-validation-for="UserNameOrEmail" class="text-danger" style="font-size: 12px; display: block; margin-top: 5px;"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn w-100 py-3 text-white fw-bold rounded-3 shadow-sm" style="background: linear-gradient(135deg, #0d6efd, #0b5ed7); transition: background 0.2s;">
                Resend Confirmation Link
            </button>

            <!-- Back to Login Link -->
            <div class="text-center mt-3">
                <p style="margin: 0; color: #64748b; font-size: 14px;">Remember your password? <a asp-action="Login" style="color: #0d6efd; text-decoration: none; font-weight: bold;">Login</a></p>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}
